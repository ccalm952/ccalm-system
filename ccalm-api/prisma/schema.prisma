generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttendancePunchType {
  morning_in
  morning_out
  afternoon_in
  afternoon_out
}

enum AttendanceRecordSource {
  normal
  makeup
}

enum AttendanceMakeupRequestStatus {
  pending
  approved
  rejected
}

enum ScheduleShiftType {
  full_rest
  morning_rest
  afternoon_rest
}

model User {
  id                  String   @id @default(uuid())
  username            String   @unique
  passwordHash        String
  displayName         String
  avatarUrl           String   @default("")
  leaveInitialBalance Float    @default(0)
  sortOrder           Int      @default(0)
  wechatOpenId        String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  records                           AttendanceRecord[]
  makeupRequests                    AttendanceMakeupRequest[]            @relation("MakeupApplicant")
  reviewedMakeupRequests            AttendanceMakeupRequest[]            @relation("MakeupReviewer")
  scheduleEntries                   ScheduleEntry[]
  scheduleLeaveOffsets              ScheduleLeaveOffset[]
  punchDevice                       AttendancePunchDevice?
  punchDeviceUnbindRequests         AttendancePunchDeviceUnbindRequest[] @relation("PunchDeviceUnbindApplicant")
  reviewedPunchDeviceUnbindRequests AttendancePunchDeviceUnbindRequest[] @relation("PunchDeviceUnbindReviewer")
  warehouseTxnsOperated             WarehouseTxn[]                       @relation("WarehouseTxnOperator")
  roles                             Role[]
}

/// 角色 = 岗位身份（可被预约 / 可配台）+ 权限点；一个用户可挂多个角色，权限取并集
model Role {
  id          String   @id @default(uuid())
  /// 显示名：管理员 / 医生 / 护士 / 自定义
  name        String   @unique
  /// 可作为「预约医生」：预约下拉、看板医生列
  bookable    Boolean  @default(false)
  /// 可作为「配台护士」：病历配台护士选人
  assistable  Boolean  @default(false)
  /// 权限点，见 common/permissions/permissions.ts
  permissions String[] @default([])
  /// 内置角色：不可删除、不可改名
  builtin     Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model GeofenceConfig {
  id        String   @id @default("global")
  enabled   Boolean  @default(false)
  centerLat Float
  centerLng Float
  radiusM   Int
  label     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftConfig {
  id                         String   @id @default("global")
  morningLabel               String   @default("上午")
  morningRangeStart          String   @default("08:30")
  morningRangeEnd            String   @default("12:00")
  afternoonLabel             String   @default("下午")
  afternoonRangeStart        String   @default("14:30")
  afternoonRangeEnd          String   @default("18:00")
  morningInWindowStart       String   @default("08:25")
  morningInWindowEnd         String   @default("09:00")
  morningOutWindowStart      String   @default("11:00")
  morningOutWindowEnd        String   @default("14:20")
  afternoonInWindowStart     String   @default("14:25")
  afternoonInWindowEnd       String   @default("15:00")
  afternoonOutWindowStart    String   @default("17:00")
  afternoonOutWindowEnd      String   @default("20:20")
  overtimeMorningNormalEnd   String   @default("12:00")
  overtimeAfternoonNormalEnd String   @default("18:00")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model AttendancePunchDevice {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  boundAt   DateTime @default(now())
}

model AttendancePunchDeviceUnbindRequest {
  id         String                        @id @default(uuid())
  userId     String
  user       User                          @relation("PunchDeviceUnbindApplicant", fields: [userId], references: [id], onDelete: Cascade)
  status     AttendanceMakeupRequestStatus @default(pending)
  reviewedBy String?
  reviewer   User?                         @relation("PunchDeviceUnbindReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model AttendanceRecord {
  id        String                 @id @default(uuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AttendancePunchType
  punchDate String
  punchTime DateTime               @default(now())
  latitude  Float
  longitude Float
  address   String                 @default("")
  source    AttendanceRecordSource @default(normal)
  createdAt DateTime               @default(now())

  @@unique([userId, type, punchDate])
  @@index([userId, punchTime])
  @@index([userId, punchDate])
  @@index([type, punchTime])
}

model AttendanceMakeupRequest {
  id         String                        @id @default(uuid())
  userId     String
  user       User                          @relation("MakeupApplicant", fields: [userId], references: [id], onDelete: Cascade)
  date       String
  type       AttendancePunchType
  punchTime  DateTime
  reason     String
  status     AttendanceMakeupRequestStatus @default(pending)
  reviewedBy String?
  reviewer   User?                         @relation("MakeupReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt

  @@index([userId, date])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model ScheduleEntry {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  shiftType ScheduleShiftType
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, date])
  @@index([date])
}

model ScheduleMonthConfig {
  month          String   @id
  monthAllowance Float    @default(0)
  updatedAt      DateTime @updatedAt
}

/// 排班表手填的假期抵消天数，对应薪资表员工假期
model ScheduleLeaveOffset {
  userId    String
  month     String
  days      Float
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, month])
  @@index([month])
}

/// holiday-cn 的年度节假日原始数据，避免每次重启都去外网下载
model HolidayYear {
  year      Int      @id
  data      Json
  fetchedAt DateTime @default(now())
}

/// 患者档案（与系统登录 User 无关），种植、待种植、正畸都挂在这里
model Patient {
  id             Int                   @id @default(autoincrement())
  name           String
  phone          String                @default("")
  chartNo        String                @default("")
  gender         String                @default("")
  birthday       String?
  age            Int?
  tags           String[]              @default([])
  remark         String                @default("")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  visits         ImplantVisit[]
  pendings       ImplantPending[]
  orthodontics   OrthodonticsPatient[]
  clinicVisits   PatientVisit[]
  medicalRecords MedicalRecord[]
  chargeOrders   ChargeOrder[]
  appointments   Appointment[]
  followUps      FollowUp[]

  @@index([name])
  @@index([phone])
  @@index([chartNo])
}

/// 患者标签库；Patient.tags 里保存标签名称
model Tag {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  color        String   @default("#64748b")
  abbreviation String   @default("")
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 就诊（预约/到店）；电子病历、收费单可挂在某次就诊上
model PatientVisit {
  id             Int             @id @default(autoincrement())
  patientId      Int
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitDate      String
  startTime      String          @default("")
  endTime        String          @default("")
  /// first 初诊 | return 复诊
  kind           String          @default("return")
  /// booked 预约 | completed 治疗完成 | cancelled 已取消 | missed 已失约
  status         String          @default("booked")
  doctor         String          @default("")
  remark         String          @default("")
  /// 预约项目名称（来自独立的预约项目字典，多选）
  items          String[]        @default([])
  /// manual 手工录入 | network 网络 | record 病历/疗程 | system 系统生成
  source         String          @default("manual")
  /// 创建人 User.id
  createdById    String?
  /// 到店时间（"到店"不是状态，有这个时间即已到店）
  arrivedAt      DateTime?
  /// 治疗完成时间
  completedAt    DateTime?
  /// 待定：无医生或无确定时段
  isPending      Boolean         @default(false)
  /// patient_time 患者时间 | doctor_schedule 医生排班 | lab 加工件 | consult 多医生会诊
  pendingReason  String          @default("")
  /// 取消/失约原因
  cancelReason   String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  medicalRecords MedicalRecord[]
  chargeOrders   ChargeOrder[]
  chargePayments ChargePayment[]
  appointment    Appointment?

  @@index([patientId, visitDate])
  @@index([visitDate])
  @@index([visitDate, status])
  @@index([visitDate, doctor])
  @@index([isPending, visitDate])
}

/// 预约项目分类（独立维护，不复用收费项目）
/// 预约（排期）；实际就诊记录仍存 PatientVisit（Visit）
model Appointment {
  id            Int           @id @default(autoincrement())
  patientId     Int
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId       Int?          @unique
  visit         PatientVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitDate     String
  startTime     String        @default("")
  endTime       String        @default("")
  /// first 初诊 | return 复诊
  kind          String        @default("return")
  /// booked 预约 | completed 治疗完成 | missed 已失约
  status        String        @default("booked")
  doctor        String        @default("")
  remark        String        @default("")
  items         String[]      @default([])
  /// booking 正常预约 | pending 待定 | walk_in 直接写病历 | orthodontics 正畸就诊
  source        String        @default("booking")
  /// 种植就诊的牙位快照（FDI，来自 ImplantTooth）；工作台内容列十字展示用
  implantTeeth String[]      @default([])
  /// 创建人 User.id
  createdById   String?
  /// 失约原因
  missedReason  String        @default("")
  completedAt   DateTime?
  /// 待定：无医生或无确定时段
  isPending     Boolean       @default(false)
  /// patient_time 患者时间 | doctor_schedule 医生排班 | lab 加工件 | consult 多医生会诊
  pendingReason String        @default("")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([patientId, visitDate])
  @@index([visitDate])
  @@index([visitDate, status])
  @@index([visitDate, doctor])
  @@index([isPending, visitDate])
}

model AppointmentSettings {
  id        String   @id @default("global")
  workStart String   @default("08:30")
  workEnd   String   @default("18:00")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppointmentCategory {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  sort      Int               @default(0)
  enabled   Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  items     AppointmentItem[]
}

/// 预约项目；PatientVisit.items 里保存名称
model AppointmentItem {
  id         Int                 @id @default(autoincrement())
  categoryId Int
  category   AppointmentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name       String
  /// 卡片配色（可选）
  color      String              @default("")
  enabled    Boolean             @default(true)
  sort       Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId, sort])
}

/// 电子病历；口腔检查/诊断/治疗计划/处置为 [{ teeth, text }] 牙位条目
model MedicalRecord {
  id             Int                 @id @default(autoincrement())
  patientId      Int
  patient        Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId        Int?
  visit          PatientVisit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  /// first 初诊 | return 复诊 | orthoFirst 正畸初诊 | orthoReturn 正畸复诊
  type           String
  visitDate      String
  visitTime      String              @default("")
  doctor         String              @default("")
  /// 配台护士（可选，仅用于追溯）
  nurse          String              @default("")
  chiefComplaint String              @default("")
  presentIllness String              @default("")
  pastHistory    String              @default("")
  oralExam       Json                @default("[]")
  auxiliaryExam  String              @default("")
  diagnosis      Json                @default("[]")
  treatment      Json                @default("[]")
  advice         String              @default("")
  remark         String              @default("")
  /// 初诊疗程终止（放弃）的日期；null 为未终止
  planStoppedAt  String?
  /// 初诊病历的治疗计划，每行一个待完成项目
  planItems      TreatmentPlanItem[] @relation("PlanItems")
  /// 复诊病历本次处理的治疗计划行
  planLinks      PlanItemFollowUp[]
  /// 以该初诊病历为疗程的收费单
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([patientId, visitDate])
  @@index([visitId])
}

/// 初诊病历治疗计划的一行；有复诊勾了完成即该行完成
model TreatmentPlanItem {
  id           Int                @id @default(autoincrement())
  recordId     Int
  record       MedicalRecord      @relation("PlanItems", fields: [recordId], references: [id], onDelete: Cascade)
  sort         Int                @default(0)
  teeth        String             @default("")
  text         String             @default("")
  /// 报价：单价 × 数量；未报价为 null
  unitPrice    Float?
  quantity     Int?
  discountNote String             @default("")
  followUps    PlanItemFollowUp[]

  @@index([recordId])
}

/// 复诊病历与治疗计划行的关联；一份复诊可处理多行
model PlanItemFollowUp {
  recordId   Int
  record     MedicalRecord     @relation(fields: [recordId], references: [id], onDelete: Cascade)
  planItemId Int
  planItem   TreatmentPlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  /// 该复诊是否完成了这一行
  completes  Boolean           @default(false)

  @@id([recordId, planItemId])
  @@index([planItemId])
}

/// 收费单；应收 = 明细金额合计，实收 = 支付记录合计
model ChargeOrder {
  id         Int             @id @default(autoincrement())
  patientId  Int
  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId    Int?
  visit      PatientVisit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  /// 是否按初诊治疗计划生成的疗程收费单；归属仍只看 visitId
  isCourse   Boolean         @default(false)
  chargeDate String
  doctor     String          @default("")
  /// normal 正常 | void 作废
  status     String          @default("normal")
  receivable Float           @default(0)
  remark     String          @default("")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  items      ChargeItem[]
  payments   ChargePayment[]

  @@index([patientId, chargeDate])
  @@index([visitId])
}

model FeeCategory {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  sort  Int       @default(0)
  items FeeItem[]
}

model FeeItem {
  id          Int          @id @default(autoincrement())
  categoryId  Int
  category    FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  price       Float        @default(0)
  sort        Int          @default(0)
  chargeItems ChargeItem[]

  @@unique([categoryId, name])
}

model ChargeItem {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     ChargeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  feeItemId Int?
  feeItem   FeeItem?    @relation(fields: [feeItemId], references: [id], onDelete: SetNull)
  name      String
  teeth     String      @default("")
  unitPrice Float       @default(0)
  quantity  Int         @default(1)
  amount    Float       @default(0)

  @@index([orderId])
}

model ChargePayment {
  id        Int           @id @default(autoincrement())
  orderId   Int
  order     ChargeOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 本次收款对应的就诊；不关联为 null
  visitId   Int?
  visit     PatientVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  amount    Float
  method    String        @default("")
  paidAt    String
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([visitId])
}

model ImplantVisit {
  id        Int            @id @default(autoincrement())
  patientId Int
  patient   Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitDate String
  remark    String?
  staff     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  teeth     ImplantTooth[]

  @@index([patientId, visitDate])
}

model ImplantTooth {
  id           Int          @id @default(autoincrement())
  visitId      Int
  visit        ImplantVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  toothNo      String?
  implantBrand String?
  implantModel String?
  toothRemark  String?

  @@index([visitId])
}

model ImplantInventory {
  id         Int    @id @default(autoincrement())
  brand      String
  model      String
  supplement Int    @default(0)
  used       Int    @default(0)

  @@unique([brand, model])
}

/// 待种植名单（可被种植记录姓名搜索引用）
model ImplantPending {
  id             Int      @id @default(autoincrement())
  patientId      Int
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  teeth          String   @default("")
  extractionDate String?
  remark         String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId])
}

model SalarySheet {
  month     String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 薪资全局设置（阶梯档位、费率、种植单价）
model SalarySettings {
  id        String   @id @default("global")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 薪资表可自定义默认模板（「设为默认」写入；无记录时前端用内置模板）
model SalaryDefaultTemplate {
  id        String   @id @default("global")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrthodonticsCategory {
  treating
  invisible
  appliance
  completed
}

enum WarehouseTxnType {
  in
  out
  adjust
}

enum WarehouseTxnBizType {
  purchase
  use
  return_in
  return_out
  adjust_in
  adjust_out
}

/// 正畸随访名单（治疗中 / 矫治器 / 已完成）
model OrthodonticsPatient {
  id             Int                  @id @default(autoincrement())
  category       OrthodonticsCategory
  patientId      Int
  patient        Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  applianceModel String               @default("")
  lastVisitDate  String?
  followUp       String               @default("")
  remark         String               @default("")
  doctor         String               @default("")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([category])
  @@index([patientId])
  @@index([lastVisitDate])
}

model WarehouseProduct {
  id           Int             @id @default(autoincrement())
  name         String
  category     String          @default("其他")
  brand        String          @default("")
  manufacturer String          @default("")
  supplierName String          @default("")
  defaultUnit  String          @default("个")
  enabled      Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        WarehouseItem[]

  @@unique([name, brand])
  @@index([name])
  @@index([category])
}

model WarehouseItem {
  id                Int              @id @default(autoincrement())
  productId         Int
  product           WarehouseProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  code              String           @unique
  spec              String           @default("")
  unit              String           @default("个")
  currentQty        Int              @default(0)
  lastPurchasePrice Float            @default(0)
  enabled           Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  txns              WarehouseTxn[]

  @@unique([productId, spec])
  @@index([productId])
}

model WarehouseTxn {
  id             Int                 @id @default(autoincrement())
  itemId         Int
  item           WarehouseItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  type           WarehouseTxnType
  bizType        WarehouseTxnBizType
  qty            Int
  unitPrice      Float               @default(0)
  amount         Float               @default(0)
  occurDate      String
  operatorUserId String?
  operatorUser   User?               @relation("WarehouseTxnOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())

  @@index([itemId, occurDate])
  @@index([type, occurDate])
}

/// 随访任务：诊疗/术后离店后按计划跟进的待办
model FollowUp {
  id           Int       @id @default(autoincrement())
  patientId    Int
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// ortho 正畸复诊 | postop 术后随访 | suture 拆线 | review 复查 | other 其他
  type         String    @default("postop")
  /// 计划随访日期 YYYY-MM-DD
  planDate     String
  content      String    @default("")
  /// 随访医生 / 执行人
  doctor       String    @default("")
  /// pending 待随访 | done 已随访 | cancelled 已取消
  status       String    @default("pending")
  result       String    @default("")
  /// satisfied 满意 | neutral 一般 | unsatisfied 不满意
  satisfaction String    @default("")
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([patientId, planDate])
  @@index([status, planDate])
}
