generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum AttendancePunchType {
  morning_in
  morning_out
  afternoon_in
  afternoon_out
}

enum AttendanceRecordSource {
  normal
  makeup
}

enum AttendanceMakeupRequestStatus {
  pending
  approved
  rejected
}

enum ScheduleShiftType {
  full_rest
  morning_rest
  afternoon_rest
}

model User {
  id           String             @id @default(uuid())
  username     String             @unique
  passwordHash String
  displayName  String
  avatarUrl    String             @default("")
  role         UserRole           @default(user)
  leaveInitialBalance Float         @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  records              AttendanceRecord[]
  makeupRequests       AttendanceMakeupRequest[] @relation("MakeupApplicant")
  reviewedMakeupRequests AttendanceMakeupRequest[] @relation("MakeupReviewer")
  scheduleEntries      ScheduleEntry[]
  punchDevice          AttendancePunchDevice?
}

model GeofenceConfig {
  id        String   @id @default("global")
  enabled   Boolean  @default(false)
  centerLat Float
  centerLng Float
  radiusM   Int
  label     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftConfig {
  id                       String   @id @default("global")
  morningLabel             String   @default("上午")
  morningRangeStart        String   @default("08:30")
  morningRangeEnd          String   @default("12:00")
  afternoonLabel           String   @default("下午")
  afternoonRangeStart      String   @default("14:30")
  afternoonRangeEnd        String   @default("18:00")
  morningInWindowStart     String   @default("08:25")
  morningInWindowEnd       String   @default("09:00")
  morningOutWindowStart    String   @default("11:00")
  morningOutWindowEnd      String   @default("14:20")
  afternoonInWindowStart   String   @default("14:25")
  afternoonInWindowEnd     String   @default("15:00")
  afternoonOutWindowStart  String   @default("17:00")
  afternoonOutWindowEnd    String   @default("20:20")
  overtimeMorningNormalEnd String   @default("12:00")
  overtimeAfternoonNormalEnd String @default("18:00")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model AttendancePunchDevice {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  boundAt   DateTime @default(now())
}

model AttendanceRecord {
  id        String                 @id @default(uuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AttendancePunchType
  punchDate String
  punchTime DateTime               @default(now())
  latitude  Float
  longitude Float
  address   String                 @default("")
  source    AttendanceRecordSource @default(normal)
  createdAt DateTime               @default(now())

  @@unique([userId, type, punchDate])
  @@index([userId, punchTime])
  @@index([userId, punchDate])
  @@index([type, punchTime])
}

model AttendanceMakeupRequest {
  id           String                        @id @default(uuid())
  userId       String
  user         User                          @relation("MakeupApplicant", fields: [userId], references: [id], onDelete: Cascade)
  date         String
  type         AttendancePunchType
  punchTime    DateTime
  reason       String
  status       AttendanceMakeupRequestStatus @default(pending)
  reviewedBy   String?
  reviewer     User?                         @relation("MakeupReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  @@index([userId, date])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model ScheduleEntry {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  shiftType ScheduleShiftType
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, date])
  @@index([date])
}

model ScheduleMonthConfig {
  month          String   @id
  monthAllowance Float    @default(0)
  updatedAt      DateTime @updatedAt
}

/// 种植模块：患者（与系统登录 User 无关）
model ImplantPatient {
  id        Int            @id @default(autoincrement())
  name      String
  phone     String
  chartNo   String         @default("")
  gender    String         @default("")
  birthday  String?
  age       Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  visits    ImplantVisit[]

  @@index([name])
  @@index([phone])
}

model ImplantVisit {
  id        Int            @id @default(autoincrement())
  patientId Int
  patient   ImplantPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitDate String
  remark    String?
  staff     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  teeth     ImplantTooth[]

  @@index([patientId, visitDate])
}

model ImplantTooth {
  id           Int          @id @default(autoincrement())
  visitId      Int
  visit        ImplantVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  toothNo      String?
  implantBrand String?
  implantModel String?
  toothRemark  String?

  @@index([visitId])
}

model ImplantInventory {
  id         Int    @id @default(autoincrement())
  brand      String
  model      String
  supplement Int    @default(0)
  used       Int    @default(0)

  @@unique([brand, model])
}

/// 待种植名单（可被种植记录姓名搜索引用）
model ImplantPending {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String
  chartNo        String   @default("")
  teeth          String   @default("")
  extractionDate String?
  remark         String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([phone])
}

model SalarySheet {
  month     String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 薪资表可自定义默认模板（「设为默认」写入；无记录时前端用内置模板）
model SalaryDefaultTemplate {
  id        String   @id @default("global")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrthodonticsCategory {
  treating
  appliance
  completed
}

/// 正畸随访名单（治疗中 / 矫治器 / 已完成）
model OrthodonticsPatient {
  id              Int                   @id @default(autoincrement())
  category        OrthodonticsCategory
  chartNo         String                @default("")
  name            String
  phone           String                @default("")
  applianceModel  String                @default("")
  lastVisitDate   String?
  followUp        String                @default("")
  remark          String                @default("")
  doctor          String                @default("")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([category])
  @@index([name])
  @@index([lastVisitDate])
}

/// 备忘录（Markdown；共享给登录用户）
model Memo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @default("")
  category  String   @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
