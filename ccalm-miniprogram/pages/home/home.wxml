<view class="app-root {{theme === 'dark' ? 'dark' : ''}}">
  <app-nav></app-nav>

  <view class="app-body">
    <view class="tab-host" style="display: {{activeIndex === 0 ? 'flex' : 'none'}}">
      <punch-tab
        id="punch-tab"
        active="{{activeIndex === 0}}"
        review-badge="{{reviewBadge}}"
        bind:attendancechanged="onAttendanceChanged"
      ></punch-tab>
    </view>
    <view class="tab-host" style="display: {{activeIndex === 1 ? 'flex' : 'none'}}">
      <schedule-tab
        id="schedule-tab"
        active="{{activeIndex === 1}}"
        bind:attendancechanged="onAttendanceChanged"
      ></schedule-tab>
    </view>
    <view class="tab-host" style="display: {{activeIndex === 2 ? 'flex' : 'none'}}">
      <stats-tab
        id="stats-tab"
        active="{{activeIndex === 2}}"
        bind:attendancechanged="onAttendanceChanged"
      ></stats-tab>
    </view>
  </view>

  <app-tab-bar
    current="{{activeIndex}}"
    missing-badge="{{missingBadge}}"
    bind:change="onTabChange"
  ></app-tab-bar>
</view>
