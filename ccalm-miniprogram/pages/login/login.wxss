.login-root {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--background);
}

.login-page {
  flex: 1;
  min-height: 0;
  justify-content: center;
}

.login-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16px;
  padding: 20px;
}

.hint-text {
  color: var(--muted-foreground);
  font-size: 14px;
  line-height: 20px;
  text-align: center;
}

.error-text {
  color: var(--destructive);
  font-size: 14px;
  line-height: 20px;
  text-align: center;
}

.login-placeholder {
  color: var(--muted-foreground);
  font-size: 14px;
}

.loading-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.login-field {
  height: 32px;
  padding: 0 12px;
  font-size: 14px;
  border: 1px solid var(--border);
  border-radius: 999px;
  overflow: hidden;
  background-color: var(--card);
  color: var(--foreground);
}

.bind-btn {
  width: 100%;
}
