/* 与打卡页相同的壁纸与半透明卡片 */

page {
  height: 100%;
  background: #0a0a0a;
  --punch-accent: #3a6f9c;
  --punch-text: #1a2d42;
  --punch-text-2: #2f4660;
  --punch-text-3: #45607a;
  --punch-text-glow: 0 0 4px rgba(255, 255, 255, 0.85),
    0 1px 1px rgba(255, 255, 255, 0.7);
  --cell-background-color: transparent;
  --cell-border-color: transparent;
  --cell-vertical-padding: 0;
  --cell-line-height: 32px;
  --field-input-text-color: var(--punch-text);
  --field-placeholder-text-color: var(--punch-text-3);
}

.wallpaper {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.page {
  position: relative;
  z-index: 1;
  background: transparent;
  padding: 16px;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card {
  width: 100%;
  max-width: 280px;
  align-self: center;
  background: rgba(255, 255, 255, 0.48);
  border: 1px solid rgba(255, 255, 255, 0.55);
  border-radius: 24px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16px;
  padding: 20px;
}

.muted {
  color: var(--punch-text-3);
  text-shadow: var(--punch-text-glow);
  font-size: 14px;
  line-height: 20px;
  text-align: center;
}

.loading-wrap {
  display: flex;
  justify-content: center;
}

.login-field {
  width: 100% !important;
  height: 32px !important;
  min-height: 32px !important;
  padding: 0 12px !important;
  background: #fff !important;
  border-radius: 999px !important;
  box-sizing: border-box !important;
  align-items: center !important;
  overflow: hidden !important;
}

.login-field:after {
  display: none !important;
}

.bind-btn {
  font-weight: 500 !important;
  font-size: 14px !important;
  height: 32px !important;
  line-height: 32px !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.error {
  color: var(--van-danger-color);
  text-shadow: var(--punch-text-glow);
  font-size: 14px;
  line-height: 20px;
  text-align: center;
}
