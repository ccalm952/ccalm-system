/* 与打卡页相同的壁纸与半透明卡片 */

page {
  height: 100%;
  background: #0a0a0a;
}

.page {
  position: relative;
  z-index: 1;
  background: transparent;
  padding: 16px;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card {
  width: 100%;
  max-width: 280px;
  align-self: center;
  background: var(--punch-card-bg);
  border: 1px solid var(--punch-card-border);
  border-radius: 24px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16px;
  padding: 20px;
}

.muted {
  color: var(--punch-text-3);
  text-shadow: var(--punch-text-glow);
  font-size: 14px;
  line-height: 20px;
  text-align: center;
}

.loading-wrap {
  display: flex;
  justify-content: center;
}

.login-field {
  --cell-background-color: #fff;
  --cell-vertical-padding: 0;
  --cell-horizontal-padding: 12px;
  --cell-line-height: 32px;
  --cell-border-color: transparent;
  --field-input-text-color: #171717;
  --field-placeholder-text-color: #737373;
}

.bind-btn {
  --button-small-height: 32px;
  --button-small-font-size: 14px;
  --button-primary-background-color: var(--punch-accent);
  --button-primary-border-color: var(--punch-accent);
  --button-primary-color: #fff;
}

.error {
  color: var(--van-danger-color);
  text-shadow: var(--punch-text-glow);
  font-size: 14px;
  line-height: 20px;
  text-align: center;
}
