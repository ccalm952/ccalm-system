<view class="app-root {{theme === 'dark' ? 'dark' : ''}} login-root">
  <view class="page login-page">
    <view class="card login-card">
      <text class="hint-text">首次使用请用现有账号绑定微信</text>

      <view wx:if="{{step === 'loading'}}" class="loading-wrap">
        <text class="hint-text">正在微信登录…</text>
      </view>

      <block wx:elif="{{step === 'bind'}}">
        <input
          class="login-field"
          value="{{username}}"
          placeholder="请输入账号"
          placeholder-class="login-placeholder"
          bindinput="onUsername"
        />
        <input
          class="login-field"
          password="{{true}}"
          value="{{password}}"
          placeholder="请输入密码"
          placeholder-class="login-placeholder"
          bindinput="onPassword"
        />
        <button
          class="btn bind-btn"
          hover-class="btn-hover"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bindtap="onBind"
        >绑定并登录</button>
      </block>

      <text wx:if="{{error}}" class="error-text">{{error}}</text>
    </view>
  </view>
</view>
