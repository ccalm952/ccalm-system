<image
  class="wallpaper"
  src="{{wallpaperSrc}}"
  mode="aspectFill"
/>
<view class="page">
  <view class="card">
    <view class="muted">首次使用请用现有账号绑定微信</view>

    <view wx:if="{{step === 'loading'}}" class="loading-wrap">
      <van-loading size="24px" color="#3a6f9c">正在微信登录…</van-loading>
    </view>

    <block wx:elif="{{step === 'bind'}}">
      <van-field
        border="{{ false }}"
        input-align="left"
        custom-class="login-field"
        value="{{username}}"
        placeholder="请输入账号"
        clearable
        bind:change="onUsername"
      />
      <van-field
        border="{{ false }}"
        input-align="left"
        custom-class="login-field"
        value="{{password}}"
        password
        placeholder="请输入密码"
        clearable
        bind:change="onPassword"
      />
      <van-button
        round
        block
        size="small"
        type="primary"
        color="#3a6f9c"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        custom-class="bind-btn"
        bind:click="onBind"
      >
        绑定并登录
      </van-button>
    </block>

    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
</view>

<van-toast id="van-toast" />
