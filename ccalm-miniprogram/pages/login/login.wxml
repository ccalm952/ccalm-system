<view class="card">
  <view class="title">CCALM 打卡</view>
  <view class="muted">首次使用请用现有账号绑定微信</view>

  <block wx:if="{{step === 'loading'}}">
    <view class="muted" style="margin-top: 32rpx">正在微信登录…</view>
  </block>

  <block wx:elif="{{step === 'bind'}}">
    <view class="field">
      <view class="label">账号</view>
      <input
        class="input"
        value="{{username}}"
        bindinput="onUsername"
        placeholder="请输入账号"
      />
    </view>
    <view class="field">
      <view class="label">密码</view>
      <input
        class="input"
        password
        value="{{password}}"
        bindinput="onPassword"
        placeholder="请输入密码"
      />
    </view>
    <button
      class="btn-primary"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onBind"
    >
      绑定并登录
    </button>
  </block>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <button
    wx:if="{{step !== 'loading'}}"
    style="margin-top: 24rpx"
    bindtap="startWechatLogin"
  >
    重新微信登录
  </button>
</view>
