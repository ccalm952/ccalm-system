<image
  class="wallpaper"
  src="{{wallpaperSrc}}"
  mode="aspectFill"
/>
<view class="page">
  <view class="card punch-hero">
    <view class="clock">{{nowText}}</view>
    <view class="date">{{todayLabel}}</view>
    <view class="loc error" wx:if="{{locError}}">{{locError}}</view>
    <view class="loc muted" wx:elif="{{address}}">{{address}}</view>
    <view class="loc muted" wx:elif="{{lat}}">{{lat}}, {{lng}}</view>
    <view class="loc muted" wx:else>尚未获取定位</view>
    <view class="locate-btn-wrap">
      <van-button
        plain
        round
        size="small"
        color="var(--punch-text)"
        custom-class="locate-btn"
        custom-style="background: transparent; border-color: transparent;"
        loading="{{locating || punching}}"
        disabled="{{locating || punching}}"
        bind:click="onRefreshLocate"
      >
        {{locating || punching ? "" : "刷新定位"}}
      </van-button>
    </view>
  </view>

  <view class="card">
    <block wx:if="{{!todaySteps.length}}">
      <view class="today-empty">
        <view class="today-empty-title">今日未打卡</view>
      </view>
    </block>
    <view class="timeline-wrap" wx:else>
      <view class="timeline">
        <view class="timeline-item" wx:for="{{todaySteps}}" wx:key="type">
          <view class="timeline-time">{{item.time}}</view>
          <view class="timeline-indicator">
            <view class="timeline-line timeline-line-before"></view>
            <view class="timeline-dot"></view>
            <view class="timeline-line timeline-line-after"></view>
          </view>
          <view class="timeline-content">
            <view class="timeline-title">{{item.text}}</view>
            <view class="timeline-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="card card-stats">
    <view class="stats">
      <view class="stat-item" wx:for="{{stats}}" wx:key="label">
        <view class="stat-value {{item.tone}}">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>

    <scroll-view scroll-x class="table-scroll" enable-flex>
      <view class="table">
        <view class="tr th">
          <view class="td">日期</view>
          <view class="td">上午上班</view>
          <view class="td">上午下班</view>
          <view class="td">下午上班</view>
          <view class="td">下午下班</view>
        </view>
        <view class="tr" wx:for="{{monthRows}}" wx:key="date">
          <view class="td">{{item.day}}</view>
          <view class="td cell {{item.morningIn.tone}}">
            <view
              class="cell-actions"
              wx:if="{{item.morningIn.actions.length || item.morningIn.pending}}"
            >
              <van-button
                wx:for="{{item.morningIn.actions}}"
                wx:for-item="action"
                wx:key="kind"
                plain
                round
                size="small"
                color="var(--punch-text)"
                custom-class="locate-btn"
                custom-style="background: transparent; border-color: transparent;"
                data-date="{{item.date}}"
                data-kind="{{action.kind}}"
                data-half="{{action.half}}"
                data-type="{{action.type}}"
                bind:click="onCellActionTap"
              >{{action.text}}</van-button>
              <text class="cell-pending" wx:if="{{item.morningIn.pending}}">审批中</text>
            </view>
            <block wx:else>{{item.morningIn.text}}</block>
          </view>
          <view class="td cell {{item.morningOut.tone}}">
            <view
              class="cell-actions"
              wx:if="{{item.morningOut.actions.length || item.morningOut.pending}}"
            >
              <van-button
                wx:for="{{item.morningOut.actions}}"
                wx:for-item="action"
                wx:key="kind"
                plain
                round
                size="small"
                color="var(--punch-text)"
                custom-class="locate-btn"
                custom-style="background: transparent; border-color: transparent;"
                data-date="{{item.date}}"
                data-kind="{{action.kind}}"
                data-half="{{action.half}}"
                data-type="{{action.type}}"
                bind:click="onCellActionTap"
              >{{action.text}}</van-button>
              <text class="cell-pending" wx:if="{{item.morningOut.pending}}">审批中</text>
            </view>
            <block wx:else>{{item.morningOut.text}}</block>
          </view>
          <view class="td cell {{item.afternoonIn.tone}}">
            <view
              class="cell-actions"
              wx:if="{{item.afternoonIn.actions.length || item.afternoonIn.pending}}"
            >
              <van-button
                wx:for="{{item.afternoonIn.actions}}"
                wx:for-item="action"
                wx:key="kind"
                plain
                round
                size="small"
                color="var(--punch-text)"
                custom-class="locate-btn"
                custom-style="background: transparent; border-color: transparent;"
                data-date="{{item.date}}"
                data-kind="{{action.kind}}"
                data-half="{{action.half}}"
                data-type="{{action.type}}"
                bind:click="onCellActionTap"
              >{{action.text}}</van-button>
              <text class="cell-pending" wx:if="{{item.afternoonIn.pending}}">审批中</text>
            </view>
            <block wx:else>{{item.afternoonIn.text}}</block>
          </view>
          <view class="td cell {{item.afternoonOut.tone}}">
            <view
              class="cell-actions"
              wx:if="{{item.afternoonOut.actions.length || item.afternoonOut.pending}}"
            >
              <van-button
                wx:for="{{item.afternoonOut.actions}}"
                wx:for-item="action"
                wx:key="kind"
                plain
                round
                size="small"
                color="var(--punch-text)"
                custom-class="locate-btn"
                custom-style="background: transparent; border-color: transparent;"
                data-date="{{item.date}}"
                data-kind="{{action.kind}}"
                data-half="{{action.half}}"
                data-type="{{action.type}}"
                bind:click="onCellActionTap"
              >{{action.text}}</van-button>
              <text class="cell-pending" wx:if="{{item.afternoonOut.pending}}">审批中</text>
            </view>
            <block wx:else>{{item.afternoonOut.text}}</block>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<van-dialog
  use-slot
  show="{{restDialogShow}}"
  show-cancel-button="{{false}}"
  show-confirm-button="{{false}}"
  custom-class="punch-dialog"
  custom-style="border: 1px solid var(--punch-card-border);"
  overlay-style="background: rgba(0, 0, 0, 0.55);"
  bind:close="onRestClose"
>
  <view class="rest-dialog">
    <view class="rest-dialog-header">
      <view class="rest-dialog-title">{{restDialogTitle}}</view>
      <view class="rest-dialog-close" bindtap="onRestClose">
        <van-icon name="cross" size="16px" color="var(--punch-text)" />
      </view>
    </view>
    <view class="rest-dialog-message">{{restDialogMessage}}</view>
    <view class="rest-dialog-footer">
      <van-button
        plain
        size="small"
        color="var(--punch-text)"
        custom-class="rest-dialog-btn"
        custom-style="border-color: var(--punch-card-border); background: transparent;"
        bind:click="onRestClose"
      >
        取消
      </van-button>
      <van-button
        size="small"
        type="primary"
        color="var(--punch-accent)"
        custom-class="rest-dialog-btn"
        bind:click="onRestConfirm"
      >
        确认
      </van-button>
    </view>
  </view>
</van-dialog>

<van-dialog
  use-slot
  show="{{makeupShow}}"
  show-cancel-button="{{false}}"
  show-confirm-button="{{false}}"
  custom-class="punch-dialog"
  custom-style="border: 1px solid var(--punch-card-border);"
  overlay-style="background: rgba(0, 0, 0, 0.55);"
  bind:close="onMakeupClose"
>
  <view class="rest-dialog">
    <view class="rest-dialog-header">
      <view class="rest-dialog-title">申请补卡</view>
      <view class="rest-dialog-close" bindtap="onMakeupClose">
        <van-icon name="cross" size="16px" color="var(--punch-text)" />
      </view>
    </view>
    <view class="makeup-dialog-body">
      <view class="makeup-dialog-meta">
        <view class="makeup-dialog-meta-line">日期：{{makeupDateLabel}}</view>
        <view class="makeup-dialog-meta-line">类型：{{makeupTypeLabel}}</view>
        <view class="makeup-dialog-meta-line">补卡时间：{{makeupTime}}</view>
      </view>
    </view>
    <view class="rest-dialog-footer">
      <van-button
        plain
        size="small"
        color="var(--punch-text)"
        custom-class="rest-dialog-btn"
        custom-style="border-color: var(--punch-card-border); background: transparent;"
        disabled="{{makeupSubmitting}}"
        bind:click="onMakeupClose"
      >
        取消
      </van-button>
      <van-button
        size="small"
        type="primary"
        color="var(--punch-accent)"
        custom-class="rest-dialog-btn"
        loading="{{makeupSubmitting}}"
        disabled="{{makeupSubmitting}}"
        bind:click="onMakeupSubmit"
      >
        确认
      </van-button>
    </view>
  </view>
</van-dialog>

<van-toast id="van-toast" />
