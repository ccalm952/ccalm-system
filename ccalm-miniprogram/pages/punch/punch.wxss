.punch-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
}

.clock {
  font-size: 72rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.date {
  font-size: 26rpx;
  color: #646566;
}

.loc {
  font-size: 24rpx;
  padding: 0 12rpx;
  word-break: break-all;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 20rpx;
}

.stat-value.warn {
  color: #ee0a24;
}

.stat-value.ok {
  color: #07c160;
}

.table {
  margin-top: 24rpx;
  border-top: 1px solid #ebedf0;
}

.tr {
  display: flex;
  border-bottom: 1px solid #f2f3f5;
}

.th {
  background: #f7f8fa;
}

.td {
  flex: 1;
  min-width: 0;
  padding: 16rpx 4rpx;
  text-align: center;
  font-size: 22rpx;
  color: #323233;
}

.th .td {
  color: #646566;
  font-weight: 500;
}

.cell {
  color: #1989fa;
}

.cell.plain {
  color: #323233;
}

.cell.muted {
  color: #969799;
}

.cell.pending {
  color: #ff976a;
}

.dialog-body {
  padding: 24rpx 32rpx 8rpx;
  font-size: 28rpx;
  color: #323233;
}

.makeup-panel {
  padding: 32rpx;
}

.makeup-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.makeup-time-label {
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}

.makeup-time {
  padding: 20rpx;
  border: 1px solid #ebedf0;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  text-align: center;
  font-size: 32rpx;
}
