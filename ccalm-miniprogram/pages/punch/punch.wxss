/* 色彩：Vant Weapp 推荐色板 */

.punch-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.clock {
  font-size: 96rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  color: var(--van-text-color);
}

.date {
  font-size: 28rpx;
  color: var(--van-text-color-3);
}

.loc {
  font-size: 28rpx;
  padding: 0 12rpx;
  word-break: break-all;
}

/* 对齐 van-button plain primary 文字色 */
.ghost-btn {
  margin: 0;
  padding: 12rpx 24rpx;
  min-height: 64rpx;
  line-height: 1.25;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--van-primary-color);
  background: transparent;
  border: none;
  border-radius: 32rpx;
}

.ghost-btn::after {
  border: none;
}

.ghost-btn[disabled] {
  color: var(--van-primary-color);
  background: transparent;
  opacity: 0.5;
}

.today-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 48rpx;
  text-align: center;
  background: var(--van-active-color);
  border-radius: 44rpx;
  box-sizing: border-box;
}

.today-empty-title {
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--van-text-color-2);
}

.card-stats {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.stats {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  width: 33.333%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
  text-align: center;
}

.stat-value,
.stat-label {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--van-text-color);
}

.stat-label {
  color: var(--van-text-color-2);
}

.stat-value.warn {
  color: var(--van-danger-color);
}

.stat-value.muted {
  color: var(--van-text-color-3);
}

.table-scroll {
  width: 100%;
}

.table {
  min-width: 1320rpx;
  border-top: 1px solid var(--van-border-color);
}

.tr {
  display: flex;
  border-bottom: 1px solid var(--van-border-color);
}

.th {
  background: var(--van-background-color);
}

.td {
  flex: 1;
  min-width: 0;
  width: 20%;
  padding: 20rpx 8rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--van-text-color);
  box-sizing: border-box;
}

.th .td {
  color: var(--van-text-color-3);
  font-weight: 400;
}

/* 可点击单元格：Vant info 蓝 */
.cell {
  color: var(--van-info-color);
}

.cell.plain {
  color: var(--van-text-color);
}

.cell.muted {
  color: var(--van-text-color-3);
}

.cell.pending {
  color: var(--van-warning-color);
}

.dialog-body {
  padding: 24rpx 32rpx 8rpx;
  font-size: 28rpx;
  color: var(--van-text-color);
}

.makeup-panel {
  padding: 40rpx;
}

.makeup-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--van-text-color);
}

.makeup-time-label {
  margin-top: 24rpx;
  margin-bottom: 8rpx;
  color: var(--van-text-color-2);
}

.makeup-time {
  padding: 20rpx;
  border: 1px solid var(--van-border-color);
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--van-text-color);
  background: var(--van-background-color-light);
}
