.hello {
  font-size: 36rpx;
  font-weight: 600;
}

.clock {
  margin-top: 16rpx;
  font-size: 56rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.section-title {
  font-weight: 600;
  margin-bottom: 16rpx;
}

.record-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1px solid #eee;
}

.punch-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.punch-btn {
  width: calc(50% - 8rpx);
  margin: 0;
  background: #111;
  color: #fff;
  font-size: 28rpx;
}

.punch-btn[disabled] {
  opacity: 0.45;
}
