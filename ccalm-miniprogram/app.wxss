page {
  background: #f7f8fa;
  color: #323233;
  font-size: 28rpx;
  box-sizing: border-box;
}

.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1px solid #ebedf0;
}

.muted {
  color: #969799;
}

.error {
  color: #ee0a24;
}
