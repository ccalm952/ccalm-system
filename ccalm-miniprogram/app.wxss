page {
  background: #f5f5f5;
  color: #111;
  font-size: 28rpx;
  box-sizing: border-box;
}

.card {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
}

.btn-primary {
  margin-top: 24rpx;
  background: #111;
  color: #fff;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.muted {
  color: #666;
}

.error {
  color: #c00;
  margin-top: 16rpx;
}
