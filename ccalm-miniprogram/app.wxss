page {
  /* Vant Weapp 推荐色 */
  --van-primary-color: #07c160;
  --van-info-color: #1989fa;
  --van-success-color: #07c160;
  --van-danger-color: #ee0a24;
  --van-warning-color: #ff976a;
  --van-text-color: #323233;
  --van-text-color-2: #646566;
  --van-text-color-3: #969799;
  --van-border-color: #ebedf0;
  --van-background-color: #f7f8fa;
  --van-background-color-light: #fafafa;
  --van-active-color: #f2f3f5;
  --van-white: #fff;

  /* 打卡/登录壁纸页：对齐网页 foreground / muted-foreground + bg-card/30 */
  --punch-card-bg: rgba(255, 255, 255, 0.3);
  --punch-card-border: rgba(0, 0, 0, 0.05);
  --punch-dialog-bg: rgba(255, 255, 255, 0.88);
  --punch-line: rgba(0, 0, 0, 0.12);
  --punch-accent: #1d4f7a;
  --punch-text: #171717;
  --punch-text-2: #3f3f3f;
  --punch-text-3: #525252;
  --punch-text-glow: 0 0 5px rgba(255, 255, 255, 0.95),
    0 1px 2px rgba(255, 255, 255, 0.9);

  font-family: Inter, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei",
    sans-serif;
  background: var(--van-background-color);
  color: var(--van-text-color);
  font-size: 28rpx;
  box-sizing: border-box;
}

@media (prefers-color-scheme: dark) {
  page {
    --punch-card-bg: rgba(33, 33, 33, 0.3);
    --punch-card-border: rgba(255, 255, 255, 0.1);
    --punch-dialog-bg: rgba(28, 28, 28, 0.9);
    --punch-line: rgba(255, 255, 255, 0.12);
    --punch-accent: #9ec9ea;
    --punch-text: #fafafa;
    --punch-text-2: #e5e5e5;
    --punch-text-3: #b4b4b4;
    --punch-text-glow: 0 0 6px rgba(0, 0, 0, 0.7),
      0 1px 3px rgba(0, 0, 0, 0.85);
  }
}

.wallpaper {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.page {
  padding: 32rpx;
  padding-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.card {
  padding: 40rpx;
  background: var(--van-white);
  border-radius: 48rpx;
  border: 1px solid var(--van-border-color);
  box-sizing: border-box;
}

.muted {
  color: var(--van-text-color-3);
}

.error {
  color: var(--van-danger-color);
}
