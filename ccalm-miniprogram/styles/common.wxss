/* Shared primitives: layout, buttons, cards, table, dialog, toast, loading, refresh. */

.app-badge {
  position: absolute;
  top: 0;
  right: 0;
  transform: translate(50%, -50%);
  min-width: 18px;
  height: 18px;
  line-height: 14px;
  padding: 2px 6px;
  border-radius: 9px;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #e15050;
  color: #ffffff;
  font-size: 12px;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
}

.app-badge-text {
  display: block;
  line-height: 14px;
  text-align: center;
}

.tab-panel {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: var(--background);
}

.tab-scroll {
  width: 100%;
  height: 0;
  flex: 1;
  min-height: 0;
  background-color: var(--background);
}

.btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 0 12px;
  margin: 0;
  border: 0;
  border-radius: 16px;
  height: 32px;
  line-height: 32px;
  background-color: var(--secondary);
  font-size: 14px;
  color: var(--foreground);
}

.btn-hover {
  background-color: var(--accent);
}

.btn::after,
.dialog-btn::after {
  border-width: 0;
}

.card {
  background-color: var(--card);
  border-radius: 24px;
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  box-sizing: border-box;
}

.page {
  background-color: var(--background);
  flex-grow: 1;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-sizing: border-box;
  min-height: 100%;
}

.muted {
  color: var(--muted-foreground);
}

.plain {
  color: var(--foreground);
}

.warn {
  color: var(--destructive);
}

.month-day {
  font-size: 14px;
  line-height: 20px;
  color: var(--foreground);
  text-align: center;
}

.cell-text {
  font-size: 14px;
  line-height: 20px;
  color: var(--primary);
  text-align: center;
}

.cell-text.plain {
  color: var(--foreground);
}

.cell-text.muted {
  color: var(--muted-foreground);
}

.cell-text.pending {
  color: var(--destructive);
}

.pending-text {
  font-size: 14px;
  line-height: 20px;
  color: var(--destructive);
  text-align: center;
}

.cell-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.grid-row {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  border-top: 1px solid var(--border);
}

.grid-row-first {
  border-top-width: 0;
}

.grid-cell {
  flex: 1;
  box-sizing: border-box;
  height: 40px;
  padding: 0 8px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.grid-cell-fixed {
  width: 128px;
  flex: 0 0 128px;
}

.grid-head {
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
  color: var(--muted-foreground);
  text-align: center;
}

/* Table container */
.table-scroll {
  width: 100%;
  flex-shrink: 0;
}

.table {
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* Dialog content (mask/header/footer live in components/feedback/dialog) */
.meta-line {
  font-size: 14px;
  line-height: 22px;
  color: var(--muted-foreground);
}

.makeup-dialog-body,
.makeup-dialog-meta {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.dialog-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 32px;
  line-height: 32px;
  padding: 0 12px;
  margin: 0;
  border: 0;
  border-radius: 16px;
  font-size: 14px;
  color: var(--primary-foreground);
}

.dialog-btn-cancel {
  background-color: var(--secondary);
  color: var(--foreground);
}

.dialog-btn-cancel-hover {
  background-color: var(--accent);
}

.dialog-btn-confirm {
  background-color: var(--primary);
}

.dialog-btn-confirm-hover {
  background-color: var(--ring);
}

/* Toast */
.toast {
  display: flex;
  position: absolute;
  left: 16px;
  right: 16px;
  top: 16px;
  z-index: 400;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  height: 52px;
  padding: 0 16px;
  box-sizing: border-box;
  border-radius: 24px;
  background-color: var(--card);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-lg);
}

.toast-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

.toast-text {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
  color: var(--foreground);
}

/* Loading */
.tab-loading {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background-color: var(--background);
}

.loading-spinner {
  width: 24px;
  height: 24px;
  border: 2px solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: ccalm-spin 0.8s linear infinite;
}

@keyframes ccalm-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 14px;
  line-height: 20px;
  color: var(--foreground);
}

/* Pull-to-refresh */
.refresh-indicator {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 5;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 30px;
  pointer-events: none;
  will-change: transform, opacity;
  transition: opacity 0.15s ease;
}

.refresh-spinner {
  width: 16px;
  height: 16px;
  transform: translateZ(0);
  will-change: transform;
}

.refresh-spinner-on {
  animation: ccalm-spin 0.7s linear infinite;
}

.refresh-text {
  font-size: 14px;
  line-height: 20px;
  color: var(--muted-foreground);
}

/* Theme-only icons */
.icon-theme-light {
  display: var(--icon-light-display);
}

.icon-theme-dark {
  display: var(--icon-dark-display);
}

