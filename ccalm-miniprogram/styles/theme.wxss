/* Design tokens and light/dark values, ported from ccalm-uniapp-x/styles/app.css */

page,
.app-root {
  --background: #fdfdfd;
  --foreground: #1a1a1a;
  --card: #f5f5f3;
  --primary: #e01062;
  --primary-foreground: #fdfdfd;
  --secondary: #eaeaea;
  --muted-foreground: #595959;
  --accent: #dedede;
  --destructive: #de1a1a;
  --border: #eaeaea;
  --ring: #e01062;
  --chart-1: #e01062;
  --chart-2: #0f766e;
  --chart-3: #b45309;
  --chart-4: #6d28d9;
  --chart-5: #047857;
  --shadow: 0 1px 2px rgba(0, 0, 0, 0.01);
  --shadow-lg: 0 4px 6px rgba(0, 0, 0, 0.03);
  --icon-light-display: inline-block;
  --icon-dark-display: none;

  background-color: var(--background);
  color: var(--foreground);
  font-family: Inter, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei",
    sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 14px;
  box-sizing: border-box;
}

.app-root.dark {
  --background: #171413;
  --foreground: #f7f2ee;
  --card: #211d1b;
  --primary: #feb4cf;
  --primary-foreground: #171413;
  --secondary: #443a36;
  --muted-foreground: #beb4af;
  --accent: #502133;
  --destructive: #ff4d4d;
  --border: #443a36;
  --ring: #f04a86;
  --chart-1: #f04a86;
  --chart-2: #14b8a6;
  --chart-3: #f59e0b;
  --chart-4: #a78bfa;
  --chart-5: #10b981;
  --shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 4px 6px rgba(0, 0, 0, 0.1);
  --icon-light-display: none;
  --icon-dark-display: inline-block;
}
