@import "../../../styles/common.wxss";

.profile-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  overflow: visible;
}

.profile-name {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hello-text {
  font-size: 22px;
  line-height: 32px;
  font-weight: 600;
  color: var(--foreground);
}

.avatar-btn {
  width: 52px;
  height: 52px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 26px;
  background-color: transparent;
  flex-shrink: 0;
  line-height: 0;
  overflow: hidden;
}

.avatar-btn::after {
  border-width: 0;
}

.avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
}

.avatar-fallback {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: var(--primary);
}

.avatar-text {
  font-size: 14px;
  font-weight: 600;
  color: var(--primary-foreground);
}

.todo-entry {
  flex-shrink: 0;
  align-self: center;
  position: relative;
  overflow: visible;
}

.todo-btn {
  flex-shrink: 0;
  height: 32px;
  padding: 0 12px;
  border-radius: 16px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: var(--secondary);
}

.todo-btn-text {
  font-size: 14px;
  line-height: 20px;
  color: var(--foreground);
}
