@import "../../../styles/common.wxss";

:host {
  display: block;
}

.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.45);
}

.dialog-center {
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dialog-panel {
  width: 280px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 24px;
  box-sizing: border-box;
  background-color: var(--card);
  border: 1px solid var(--border);
  border-radius: 24px;
}

.dialog-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.dialog-header-end {
  justify-content: flex-end;
}

.dialog-title {
  flex: 1;
  font-size: 18px;
  line-height: 32px;
  font-weight: 600;
  color: var(--foreground);
}

.dialog-close {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background-color: var(--secondary);
}

.dialog-close-icon {
  width: 16px;
  height: 16px;
}

.dialog-message {
  font-size: 14px;
  line-height: 22px;
  color: var(--muted-foreground);
}

.dialog-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.dialog-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
}
