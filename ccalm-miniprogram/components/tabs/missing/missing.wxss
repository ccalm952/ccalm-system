@import "../../../styles/common.wxss";

:host {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  flex: 1;
  min-height: 0;
}

.missing-page {
  height: 100%;
  min-height: 0;
}

.card-missing {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
  overflow: hidden;
}

.head {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.table-y {
  width: 100%;
}

.head-value {
  font-size: 14px;
  line-height: 20px;
  color: var(--foreground);
  text-align: center;
}

.head-value.warn {
  color: var(--destructive);
}

.head-value.muted {
  color: var(--muted-foreground);
}

.head-label {
  font-size: 14px;
  line-height: 20px;
  color: var(--muted-foreground);
  text-align: center;
}
