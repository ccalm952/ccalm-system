@import "../../../styles/common.wxss";

:host {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  flex: 1;
  min-height: 0;
}

.stats-page {
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

.stats-card {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.stats-block {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.stats-table-host {
  width: 100%;
  min-width: 0;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.stats-table-y {
  width: 100%;
  height: 0;
  flex: 1;
  min-height: 0;
}

.stats-table-y::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.stats-card > .empty-text {
  margin: auto;
}

.summary-row-on {
  background-color: var(--secondary);
}

.summary-row-hover {
  background-color: var(--accent);
}

.cell-text {
  color: var(--foreground);
}

.cell-name {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cell-head {
  color: var(--muted-foreground);
}

.cell-danger {
  color: var(--destructive);
}

.empty-text {
  display: block;
  font-size: 14px;
  line-height: 20px;
  color: var(--muted-foreground);
  text-align: center;
}

.time-field {
  position: relative;
  height: 32px;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 0 6px;
}

.time-seg {
  flex-shrink: 0;
  padding: 0 3px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
}

.time-seg-on {
  background-color: #0a84ff;
}

.time-seg-text,
.time-colon {
  font-size: 14px;
  line-height: 20px;
  color: var(--foreground);
  text-align: center;
}

.time-seg-text-on {
  color: #ffffff;
}

.time-colon {
  padding: 0 2px;
  flex-shrink: 0;
}

.time-key {
  position: absolute;
  left: 0;
  top: 0;
  width: 1px;
  height: 1px;
  opacity: 0;
}
