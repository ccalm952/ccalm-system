@import "../../../styles/common.wxss";

:host {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  flex: 1;
  min-height: 0;
}

.month-switch {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.month-arrow {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  border-radius: 16px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: var(--secondary);
}

.month-arrow-hover {
  background-color: var(--accent);
}

.month-arrow-disabled {
  opacity: 0.35;
}

.month-arrow-icon {
  width: 20px;
  height: 20px;
}

.month-title {
  flex: 1;
  min-width: 0;
  font-size: 16px;
  line-height: 20px;
  color: var(--foreground);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.stats-table .grid-cell-name,
.stats-table .grid-cell-date {
  width: 64px;
  flex: 0 0 64px;
}

.stats-page {
  min-height: 100%;
}

.stats-card {
  flex: 1;
  min-height: 0;
}

.stats-block {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.stats-table-host {
  width: 100%;
  min-width: 0;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.stats-table-y {
  width: 100%;
  height: 0;
  flex: 1;
  min-height: 0;
}

.stats-card > .empty-text {
  margin: auto;
}

.summary-row-on {
  background-color: var(--secondary);
}

.summary-row-hover {
  background-color: var(--accent);
}

.cell-text {
  color: var(--foreground);
}

.cell-name {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.grid-cell-sticky {
  position: sticky;
  left: 0;
  z-index: 3;
  background-color: var(--card);
}

.summary-row-on .grid-cell-sticky {
  background-color: var(--secondary);
}

.summary-row-hover .grid-cell-sticky {
  background-color: var(--accent);
}

.cell-head {
  color: var(--muted-foreground);
}

.cell-danger {
  color: var(--destructive);
}

.empty-text {
  display: block;
  font-size: 14px;
  line-height: 20px;
  color: var(--muted-foreground);
  text-align: center;
}

.time-field {
  position: relative;
  height: 32px;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 0 6px;
}

.time-seg {
  flex-shrink: 0;
  padding: 0 3px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
}

.time-seg-on {
  background-color: #0a84ff;
}

.time-seg-text,
.time-colon {
  font-size: 14px;
  line-height: 20px;
  color: var(--foreground);
  text-align: center;
}

.time-seg-text-on {
  color: #ffffff;
}

.time-colon {
  padding: 0 2px;
  flex-shrink: 0;
}

.time-key {
  position: absolute;
  left: 0;
  top: 0;
  width: 1px;
  height: 1px;
  opacity: 0;
}
