<view class="tab-panel">
  <view
    class="refresh-indicator"
    style="transform: translate3d(0, {{pullY}}px, 0); opacity: {{pullOpacity}};"
  >
    <image class="refresh-spinner {{refreshing || pullDistance > 0 ? 'refresh-spinner-on' : ''}}" src="/assets/icons/spinner.png" mode="aspectFit"></image>
    <text class="refresh-text">{{refreshing ? '正在刷新' : (pullDistance > pullThreshold ? '松手刷新' : '下拉刷新')}}</text>
  </view>

  <scroll-view
    class="tab-scroll"
    scroll-y
    enable-flex
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    refresher-default-style="none"
    refresher-threshold="{{pullThreshold}}"
    bindrefresherpulling="onRefresherPulling"
    bindrefresherrestore="onRefresherRestore"
    bindrefresherabort="onRefresherAbort"
    bindrefresherrefresh="onRefresherRefresh"
  >
    <view class="page mine-page">
      <view class="hero">
        <view class="who">
          <button
            class="avatar-btn"
            open-type="chooseAvatar"
            bindchooseavatar="onChooseAvatar"
          >
            <image
              wx:if="{{avatarUrl}}"
              class="avatar"
              src="{{avatarUrl}}"
              mode="aspectFill"
            ></image>
            <view wx:else class="avatar avatar-fallback">
              <text class="avatar-text">{{avatarText}}</text>
            </view>
          </button>
          <view class="who-text">
            <text class="hello-text">{{displayName}}</text>
          </view>
          <view class="todo-entry">
            <view class="todo-btn" bindtap="onTodoOpen">
              <text class="todo-btn-text">待办</text>
            </view>
            <view wx:if="{{badgeText}}" class="todo-badge">{{badgeText}}</view>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="stats">
          <view class="stat" wx:for="{{stats}}" wx:key="label">
            <text class="stat-value">{{item.value}}</text>
            <text class="stat-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="func-grid">
          <view
            class="func-item"
            wx:for="{{funcs}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onFunc"
          >
            <view class="func-icon">
              <image class="func-icon-img" src="{{item.icon}}" mode="aspectFit"></image>
            </view>
            <text class="func-label">{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{pageLoading}}" class="tab-loading">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中</text>
  </view>
  <view wx:if="{{toastText}}" class="toast">
    <block wx:if="{{toastType === 'success'}}">
      <image class="toast-icon icon-theme-light" src="/assets/icons/toast-success.png" mode="aspectFit"></image>
      <image class="toast-icon icon-theme-dark" src="/assets/icons/toast-success-dark.png" mode="aspectFit"></image>
    </block>
    <image wx:else class="toast-icon" src="/assets/icons/toast-error.png" mode="aspectFit"></image>
    <text class="toast-text">{{toastText}}</text>
  </view>

  <view wx:if="{{todoShow}}" class="todo-layer">
    <view class="todo-mask" bindtap="onTodoClose" catchtouchmove="noop"></view>
    <view class="todo-panel" catchtap="onTodoKeep">
      <view wx:if="{{isAdmin}}" class="todo-tabs">
        <view
          class="todo-tab {{todoTab === 'mine' ? 'todo-tab-on' : ''}}"
          data-tab="mine"
          bindtap="onTodoTab"
        >
          <text class="todo-tab-text {{todoTab === 'mine' ? 'todo-tab-text-on' : ''}}">我创建的</text>
        </view>
        <view
          class="todo-tab {{todoTab === 'pending' ? 'todo-tab-on' : ''}}"
          data-tab="pending"
          bindtap="onTodoTab"
        >
          <text class="todo-tab-text {{todoTab === 'pending' ? 'todo-tab-text-on' : ''}}">待我处理</text>
        </view>
      </view>

      <scroll-view class="todo-scroll" scroll-y>
        <text wx:if="{{!todoItems.length}}" class="todo-empty-text">{{todoEmpty}}</text>
        <view class="todo-item" wx:for="{{todoItems}}" wx:key="key">
          <view class="todo-item-main">
            <text wx:if="{{item.title}}" class="todo-item-title">{{item.title}}</text>
            <text class="todo-item-line">{{item.line}}</text>
          </view>
          <view wx:if="{{item.canReview}}" class="todo-item-side">
            <button
              class="btn"
              hover-class="btn-hover"
              data-kind="{{item.kind}}"
              data-id="{{item.id}}"
              bindtap="onTodoApprove"
            >通过</button>
            <button
              class="btn"
              hover-class="btn-hover"
              data-kind="{{item.kind}}"
              data-id="{{item.id}}"
              bindtap="onTodoReject"
            >拒绝</button>
          </view>
          <text wx:else class="todo-status {{item.status}}">{{item.statusLabel}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
