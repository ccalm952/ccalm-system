@import "../../../styles/common.wxss";

:host {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  flex: 1;
  min-height: 0;
}

.mine-page {
  overflow: visible;
}

.hero {
  padding: 0;
  overflow: visible;
}

.who {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  overflow: visible;
}

.who-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.todo-entry {
  flex-shrink: 0;
  align-self: center;
  position: relative;
  overflow: visible;
}

.todo-btn {
  flex-shrink: 0;
  height: 32px;
  padding: 0 12px;
  border-radius: 16px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: var(--secondary);
}

.todo-btn-text {
  font-size: 14px;
  line-height: 20px;
  color: var(--foreground);
}

.todo-badge {
  position: absolute;
  top: 0;
  right: 0;
  transform: translate(50%, -50%);
  min-width: 14px;
  height: 14px;
  line-height: 14px;
  border-radius: 7px;
  background-color: var(--primary);
  color: #ffffff;
  font-size: 10px;
  text-align: center;
  white-space: nowrap;
}

.avatar-btn {
  width: 52px;
  height: 52px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 26px;
  background-color: transparent;
  flex-shrink: 0;
  line-height: 0;
  overflow: hidden;
}

.avatar-btn::after {
  border-width: 0;
}

.avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
}

.avatar-fallback {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: var(--primary);
}

.avatar-text {
  font-size: 14px;
  font-weight: 600;
  color: var(--primary-foreground);
}

.hello-text {
  font-size: 22px;
  line-height: 32px;
  font-weight: 600;
  color: var(--foreground);
}

.stats {
  display: flex;
  flex-direction: row;
  gap: 0;
  padding: 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  padding: 0;
}

.stat-value {
  font-size: 14px;
  line-height: 20px;
  font-weight: 400;
  color: var(--foreground);
  text-align: center;
}

.stat-label {
  margin: 0;
  padding: 0;
  font-size: 14px;
  line-height: 20px;
  font-weight: 400;
  color: var(--muted-foreground);
  text-align: center;
}

.func-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.func-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 12px 0;
}

.func-icon {
  width: 26px;
  height: 26px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.func-icon-img {
  width: 22px;
  height: 22px;
}

.func-label {
  font-size: 14px;
  line-height: 20px;
  color: var(--muted-foreground);
}

.todo-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: flex;
  flex-direction: column;
  background-color: rgba(0, 0, 0, 0.55);
}

.todo-mask {
  flex: 1;
}

.todo-panel {
  height: 70%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 16px 16px calc(16px + env(safe-area-inset-bottom));
  border-radius: 16px 16px 0 0;
  background-color: var(--card);
}

.todo-tabs {
  display: flex;
  flex-direction: row;
  gap: 8px;
}

.todo-tab {
  height: 32px;
  padding: 0 12px;
  border-radius: 16px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: var(--secondary);
}

.todo-tab-on {
  background-color: var(--primary);
}

.todo-tab-text {
  font-size: 14px;
  line-height: 32px;
  color: var(--muted-foreground);
}

.todo-tab-text-on {
  color: var(--primary-foreground);
}

.todo-scroll {
  flex: 1;
  height: 0;
  margin-top: 12px;
}

.todo-empty-text {
  display: block;
  padding: 24px 0;
  text-align: center;
  font-size: 14px;
  line-height: 20px;
  color: var(--muted-foreground);
}

.todo-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 12px;
}

.todo-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.todo-item-title {
  font-size: 14px;
  line-height: 20px;
  font-weight: 600;
  color: var(--foreground);
}

.todo-item-line {
  margin-top: 2px;
  font-size: 14px;
  line-height: 20px;
  color: var(--muted-foreground);
}

.todo-item-side {
  display: flex;
  flex-direction: row;
  gap: 8px;
  flex-shrink: 0;
}

.todo-status {
  flex-shrink: 0;
  font-size: 14px;
  line-height: 20px;
  color: var(--muted-foreground);
}

.todo-status.pending {
  color: var(--chart-4);
}

.todo-status.approved {
  color: var(--chart-5);
}

.todo-status.rejected {
  color: var(--destructive);
}
