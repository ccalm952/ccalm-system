@import "../../../styles/common.wxss";

:host {
  display: block;
  flex-shrink: 0;
  width: 100%;
}

.app-nav {
  flex-shrink: 0;
  width: 100%;
  background-color: var(--background);
}

.app-nav-content {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.app-nav-title {
  flex: 1;
  min-width: 0;
  font-size: 17px;
  line-height: 22px;
  font-weight: 600;
  color: var(--foreground);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
