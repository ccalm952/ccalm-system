@import "../../../styles/common.wxss";

:host {
  display: block;
  flex-shrink: 0;
  width: 100%;
}

.app-nav {
  flex-shrink: 0;
  width: 100%;
  background-color: var(--background);
}

.app-nav-content {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.nav-toast {
  position: absolute;
  top: 50%;
  z-index: 900;
  height: 32px;
  padding: 0 12px;
  box-sizing: border-box;
  border-radius: 16px;
  display: inline-flex;
  width: auto;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  background-color: var(--card);
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.nav-toast-icon {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
}

.nav-toast-text {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  line-height: 20px;
  color: var(--foreground);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.app-nav-title {
  flex: 1;
  min-width: 0;
  font-size: 17px;
  line-height: 22px;
  font-weight: 600;
  color: var(--foreground);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
